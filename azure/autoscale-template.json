{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "autoscaleSettingName": { "type": "string" },
    "targetResourceUri": { "type": "string" },
    "minCapacity": { "type": "string", "defaultValue": "1" },
    "maxCapacity": { "type": "string", "defaultValue": "5" },
    "defaultCapacity": { "type": "string", "defaultValue": "1" }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/autoscalesettings",
      "apiVersion": "2015-04-01",
      "name": "[parameters('autoscaleSettingName')]",
      "location": "global",
      "properties": {
        "name": "[parameters('autoscaleSettingName')]",
        "enabled": true,
        "targetResourceUri": "[parameters('targetResourceUri')]",
        "profiles": [
          {
            "name": "AutoScaleProfile",
            "capacity": {
              "minimum": "[parameters('minCapacity')]",
              "maximum": "[parameters('maxCapacity')]",
              "default": "[parameters('defaultCapacity')]"
            },
            "rules": [
              {
                "metricTrigger": {
                  "metricName": "Percentage CPU",
                  "metricResourceUri": "[parameters('targetResourceUri')]",
                  "timeGrain": "PT1M",
                  "statistic": "Average",
                  "timeWindow": "PT5M",
                  "timeAggregation": "Average",
                  "operator": "GreaterThan",
                  "threshold": 70
                },
                "scaleAction": {
                  "direction": "Increase",
                  "type": "ChangeCount",
                  "value": "1",
                  "cooldown": "PT5M"
                }
              },
              {
                "metricTrigger": {
                  "metricName": "Percentage CPU",
                  "metricResourceUri": "[parameters('targetResourceUri')]",
                  "timeGrain": "PT1M",
                  "statistic": "Average",
                  "timeWindow": "PT10M",
                  "timeAggregation": "Average",
                  "operator": "LessThan",
                  "threshold": 30
                },
                "scaleAction": {
                  "direction": "Decrease",
                  "type": "ChangeCount",
                  "value": "1",
                  "cooldown": "PT10M"
                }
              }
            ]
          }
        ],
        "notifications": []
      }
    }
  ]
}
